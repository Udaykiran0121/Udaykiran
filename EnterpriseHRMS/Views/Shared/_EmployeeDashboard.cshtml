<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - GenZStaff | GenZ-Tech Solutions</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            @Html.ActionLink("GenZ-Tech Solutions", "Index", "EmployeeDashboard",null, new { @class = "navbar-brand" })
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <li>@Html.ActionLink("My Workplace", "Index", "EmployeeDashboard",null,new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Logout", "Logoff", "Account", null, new { @class = "nav-link" })</li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year -GenZ-Tech Staff</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
