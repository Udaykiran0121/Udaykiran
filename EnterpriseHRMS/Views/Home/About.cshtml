@{
    ViewBag.Title = "About Us";
}

<style>
    .about-hero {
        background: linear-gradient(to right, #1f4037, #99f2c8);
        color: white;
        padding: 80px 0;
        text-align: center;
    }

    .about-section {
        padding: 60px 0;
    }

    .about-card {
        padding: 30px;
        border-radius: 10px;
        background: #f8f9fa;
        transition: 0.3s;
    }

        .about-card:hover {
            transform: translateY(-6px);
            box-shadow: 0px 10px 25px rgba(0,0,0,0.1);
        }

    .value-box {
        background-color: #ffffff;
        padding: 25px;
        border-radius: 8px;
        box-shadow: 0px 5px 15px rgba(0,0,0,0.05);
        transition: 0.3s;
    }

        .value-box:hover {
            transform: scale(1.03);
        }
</style>

<section class="about-hero">
    <div class="container">
        <h1>About GenZ-Tech Solutions</h1>
        <p class="lead mt-3">
            Building smarter workplaces through innovation and technology.
        </p>
    </div>
</section>

<section class="about-section">
    <div class="container">
        <div class="text-center mb-5">
            <h2>Who We Are</h2>
            <p>
                GenZ-Tech Solutions is a forward-thinking technology company
                focused on modern HR and enterprise solutions.
                We design secure, scalable, and intelligent systems
                that simplify workforce management.
            </p>
        </div>

        <div class="row text-center">

            <div class="col-md-4">
                <div class="about-card">
                    <h4>Our Mission</h4>
                    <p>
                        To empower organizations with reliable and
                        future-ready HR technology solutions.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="about-card">
                    <h4>Our Vision</h4>
                    <p>
                        To become a global leader in workforce
                        transformation through digital innovation.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="about-card">
                    <h4>Our Commitment</h4>
                    <p>
                        We are committed to quality, transparency,
                        and long-term client partnerships.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="about-section bg-light">
    <div class="container">
        <h2 class="text-center mb-5">Our Core Values</h2>

        <div class="row text-center">

            <div class="col-md-3">
                <div class="value-box">
                    <h5>Integrity</h5>
                    <p>We operate with honesty and ethical responsibility.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="value-box">
                    <h5>Innovation</h5>
                    <p>We continuously improve and adapt to new technologies.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="value-box">
                    <h5>Excellence</h5>
                    <p>We strive to deliver high-quality enterprise solutions.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="value-box">
                    <h5>Collaboration</h5>
                    <p>We believe in teamwork and shared success.</p>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="about-section">
    <div class="container text-center">
        <h2 class="mb-4">Leadership Message</h2>
        <p>
            At GenZ-Tech Solutions, we believe that technology should
            empower people — not complicate their work.
            Our goal is to create smart systems that enhance productivity,
            transparency, and growth for organizations worldwide.
        </p>
    </div>
</section>