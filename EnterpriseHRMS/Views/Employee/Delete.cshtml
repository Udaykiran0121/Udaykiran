@model EnterpriseHRMS.Models.EmployeeModel

<h2>Delete Employee</h2>

<h3 style="color:red">Are you sure you want to delete this employee?</h3>

<dl>
    <dt>Name</dt>
    <dd>@Model.EmpFullName</dd>

    <dt>Email</dt>
    <dd>@Model.Email</dd>

    <dt>Department</dt>
    <dd>@Model.Department</dd>

    <dt>Joining Date</dt>
    <dd>@Model.JoiningDate</dd>
</dl>

@using (Html.BeginForm("Delete", "Employee", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Id)

    <button type="submit"
            class="btn btn-danger"
            onclick="return confirm('Are you sure you want to delete this employee?');">
        Delete
    </button>

    @Html.ActionLink("Cancel", "Index", "Employee",
        null, new { @class = "btn btn-secondary" })
}