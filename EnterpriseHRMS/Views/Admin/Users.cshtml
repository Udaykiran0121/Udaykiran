@model IEnumerable<EnterpriseHRMS.Models.ApplicationUser>
@{
    ViewBag.Title = "Users";
}

<h2>All Users</h2>
<table class="table table-bordered">
    <tr>
        <th>UserName</th>
        <th>Email</th>
        <th>Phone Number</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.UserName</td>
            <td>@item.Email</td>
            <td>@item.PhoneNumber</td>
        </tr>
    }
</table
<a href="@Url.Action("Index","Admin")">
    Back To Dashboard
</a>

