@model EnterpriseHRMS.Models.AdminViewModel

@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .dashboard-container {
        margin-top: 20px;
    }

    .dashboard-card {
        border-radius: 12px;
        padding: 20px;
        color: white;
        text-align: center;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        transition: 0.3s;
    }

        .dashboard-card:hover {
            transform: scale(1.05);
        }

    .card-users {
        background: linear-gradient(45deg,#007bff,#00c6ff);
    }

    .card-emp {
        background: linear-gradient(45deg,#28a745,#7ed957);
    }

    .card-hr {
        background: linear-gradient(45deg,#ff9800,#ffc107);
    }

    .card-manager {
        background: linear-gradient(45deg,#9c27b0,#e040fb);
    }

    .dashboard-title {
        font-size: 28px;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .dashboard-number {
        font-size: 35px;
        font-weight: bold;
    }
</style>

<div class="container dashboard-container">

    <h2 class="dashboard-title">Admin Control Panel</h2>

    <div class="row">

        <div class="col-md-3">
            <div class="dashboard-card card-users">
                <h4>Total Users</h4>
                <div class="dashboard-number">@Model.TotalUsers</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card card-emp">
                <h4>Total Employees</h4>
                <div class="dashboard-number">@Model.TotalEmployees</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card card-hr">
                <h4>Total HR</h4>
                <div class="dashboard-number">@Model.TotalHR</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card card-manager">
                <h4>Total Managers</h4>
                <div class="dashboard-number">@Model.TotalManagers</div>
            </div>
        </div>

    </div>

    <hr />

    <div class="row mt-4">

        <div class="col-md-4">
            <a href="/Employee/Index" class="btn btn-primary btn-block">
                Manage Employees
            </a>
        </div>

        <div class="col-md-4">
            <a href="/Admin/HR" class="btn btn-warning btn-block">
                View HR List
            </a>
        </div>

        <div class="col-md-4">
            <a href="/Admin/Managers" class="btn btn-info btn-block">
                View Managers
            </a>
        </div>

    </div>

</div>