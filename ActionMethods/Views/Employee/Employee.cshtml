@model ActionMethods.Models.Employee;
{
<h1>@ViewData["Employee"]</h1>
<table>
    <tr>
        <td>Employee ID:</td>
        <td>@Model.Id</td>
    </tr>
    <tr>
        <td>First Name:</td>
        <td>@Model.Name</td>
    </tr>
    
    <tr>
        <td>Description:</td>
        <td>@Model.Description</td>
    </tr>
</table>
}


